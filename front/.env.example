NEXT_PUBLIC_API_URL=http://localhost:3001

# Dominio público del sitio, con esquema y sin barra final.
# Ponla en TODOS los despliegues. El host canónico de producción es
# https://www.vuelocarmesi.com: el apex (sin `www`) hace 301 hacia él, así que un
# canonical sin `www` declara como buena una URL que redirige.
# En un despliegue de PRUEBA en otro dominio, ponle el dominio de esa copia para
# que su canonical apunte a sí misma y las dos no compitan en el índice de Google.
# Vacía o ausente, el código cae al respaldo https://www.vuelocarmesi.com, que es
# la última red y no un sustituto de definirla.
NEXT_PUBLIC_SITE_URL=

# Contraseña del panel de administración.
ADMIN_PASSWORD=

# Firma la cookie de sesión del panel. Solo en Vercel, distinta de ADMIN_API_KEY.
# Mínimo 32 caracteres. Cambiarla cierra todas las sesiones abiertas.
ADMIN_SESSION_SECRET=

# La misma clave que ADMIN_API_KEY en Render: el puente del panel la manda al
# backend en `x-admin-key`. Mínimo 32 caracteres. Generar ambas con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=
