DATABASE_URL="postgresql://user:password@localhost:5432/vuelocarmesi"

# Traduccion automatica es->en de fichas de experiencia y producto.
# Plan gratuito: https://www.deepl.com/pro-api (500.000 caracteres/mes)
DEEPL_API_KEY=

# Clave que el servidor del front manda en `x-admin-key` para usar las rutas de
# administración. La MISMA en Render (aquí) y en Vercel. Mínimo 32 caracteres;
# sin ella el backend rechaza toda ruta de admin. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=
