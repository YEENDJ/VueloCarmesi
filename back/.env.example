DATABASE_URL="postgresql://user:password@localhost:5432/vuelocarmesi"

# Traduccion automatica es->en de fichas de experiencia y producto.
# Plan gratuito: https://www.deepl.com/pro-api (500.000 caracteres/mes)
DEEPL_API_KEY=

# Clave que el servidor del front manda en `x-admin-key` para usar las rutas de
# administración. La MISMA en Render (aquí) y en Vercel. Mínimo 32 caracteres;
# sin ella el backend rechaza toda ruta de admin. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# Pasarela de pagos. Vacía = cobro en línea apagado: pedidos y reservas siguen el
# flujo manual de siempre. `wompi` = Wompi (sandbox o producción según las
# llaves). `falso` = pasarela de mentira que no cobra nada, solo para desarrollo.
# Ver docs/superpowers/specs/2026-09-25-pasarela-pagos-design.md
PAGOS_PROVEEDOR=
# Con qué firma sus webhooks la pasarela falsa. Sin él, no acepta ninguno.
PAGOS_FALSO_SECRETO=
# Credenciales de Wompi (panel > Desarrolladores). Las de prueba empiezan por
# pub_test_/prv_test_ y van contra el sandbox; las de producción, por
# pub_prod_/prv_prod_, cobran de verdad. No mezclar: el backend apaga el cobro.
# Los dos secretos son distintos en cada ambiente. Solo servidor, nunca al front.
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_EVENTOS=
WOMPI_SECRETO_INTEGRIDAD=
