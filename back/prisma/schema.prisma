// Prisma schema for Vuelo Carmesí
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Experiencia {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  nombre           String
  // Ya no va en la tarjeta: su único trabajo es la meta description de Google,
  // donde el recorte cae en ~160 caracteres. Es opcional; si está vacía se
  // derivan las primeras líneas de descripcionLarga.
  descripcion      String                  @default("")
  // El relato. Es el texto principal de la ficha y se escribe en párrafos.
  descripcionLarga String                  @default("")
  duracion         String
  /// Pesos enteros, sin decimales. Ver el comentario de `Pago.monto`.
  precio           Int
  capacidad        Int
  // Prácticos: opcionales, la ficha absorbe su ausencia sin verse incompleta.
  horarios         String                  @default("")
  // Edad mínima, condición física, advertencias.
  recomendaciones  String                  @default("")
  // Vacío = se usa el punto de encuentro por defecto de SiteConfig. Solo se
  // llena cuando esta experiencia sale de otro lado.
  puntoEncuentro   String                  @default("")
  // `imagenes` es la fuente de verdad y su primer elemento es la portada.
  // `imagen` se conserva porque lo consumen tarjetas, carrito y correos; el
  // service lo mantiene sincronizado con imagenes[0] para que no se separen.
  imagen           String                  @default("")
  imagenes         String[]                @default([])
  incluye          String[]                @default([])
  queTraer         String[]                @default([])
  noIncluye        String[]                @default([])
  destacada        Boolean                 @default(false)
  archivada        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  reservas         Reserva[]
  traducciones     ExperienciaTraduccion[]
}

model Reserva {
  id               String      @id @default(cuid())
  experienciaId    String
  experiencia      Experiencia @relation(fields: [experienciaId], references: [id])
  fecha            DateTime
  cantidadPersonas Int
  nombre           String
  email            String
  telefono         String
  notas            String?
  /// pendiente | pendiente_pago | confirmada | cancelada | expirada | requiere_revision
  ///
  /// `pendiente` es el flujo manual de antes de la pasarela: el admin la
  /// confirma a mano. Las que se cobran en línea nacen en `pendiente_pago`.
  estado           String      @default("pendiente")

  /// Lo que se le ofreció al cliente, congelado al crear la reserva: si el
  /// precio de la experiencia o el porcentaje de abono cambian después, esta
  /// reserva conserva sus cifras y el saldo del día queda exacto.
  ///
  /// Nulos en las reservas de antes de la pasarela. Rellenarlas con el precio
  /// de hoy sería inventar lo que se les cobró.
  total            Int?
  porcentajeAbono  Int?
  montoAbono       Int?
  /// Hasta cuándo se sostiene sin un pago aprobado. Nulo si no espera pago.
  venceEn          DateTime?

  createdAt        DateTime    @default(now())
  pagos            Pago[]

  @@index([estado, venceEn])
}

model Producto {
  id               String               @id @default(cuid())
  slug             String               @unique
  nombre           String
  // Igual que en Experiencia: la corta sale de la tarjeta y queda como meta
  // description, opcional y con respaldo desde la larga.
  descripcion      String               @default("")
  descripcionLarga String               @default("")
  /// Pesos enteros.
  precio           Int
  stock            Int
  // imagenes[0] es la portada; `imagen` queda sincronizada por el service.
  imagen           String               @default("")
  imagenes         String[]             @default([])
  categoria        String
  badge            String?
  createdAt        DateTime             @default(now())
  itemsPedido      ItemPedido[]
  traducciones     ProductoTraduccion[]
}

model Pedido {
  id           String       @id @default(cuid())
  nombre       String
  email        String
  telefono     String
  direccion    String
  ciudad       String
  codigoPostal String
  total        Int
  /// pendiente | pendiente_pago | pagado | enviado | entregado | cancelado | expirado | requiere_revision
  ///
  /// `pendiente` es el flujo manual de antes de la pasarela, donde el pago se
  /// coordinaba por fuera. Los pedidos cobrados en línea nacen en `pendiente_pago`.
  estado       String       @default("pendiente")
  /// Hasta cuándo se aparta el stock sin un pago aprobado. Nulo si no espera pago.
  venceEn      DateTime?
  /// Si las unidades de este pedido están descontadas del inventario.
  ///
  /// Con los estados de la pasarela ya no alcanza con mirar el estado: un
  /// pedido `expirado` ya las devolvió, uno `requiere_revision` puede tenerlas
  /// o no según por qué llegó ahí. Devolver stock mirando solo el estado las
  /// devolvía dos veces. Quien devuelve las unidades lo pone en false.
  stockApartado Boolean     @default(true)
  createdAt    DateTime     @default(now())
  items        ItemPedido[]
  pagos        Pago[]

  @@index([estado, venceEn])
}

model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  /// Precio unitario en pesos enteros, copiado al crear el pedido.
  precio     Int
}

/// Un intento de cobro sobre un pedido o una reserva.
///
/// Uno por intento, no uno por pedido: si el banco rechaza, el cliente
/// reintenta con otro método y eso es un `Pago` nuevo con otra referencia,
/// mientras el pedido conserva el stock apartado. Pertenece a un pedido **o** a
/// una reserva, nunca a los dos: lo garantiza un CHECK en la migración.
///
/// Diseño y casos de fallo en docs/superpowers/specs/2026-09-25-pasarela-pagos-design.md.
model Pago {
  id            String   @id @default(cuid())
  /// La que se le envía a la pasarela. Única y nunca reutilizada.
  referencia    String   @unique
  pedidoId      String?
  /// Restrict: un cobro no se borra con su pedido. Es el registro que
  /// responde un reclamo o un contracargo meses después.
  pedido        Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  reservaId     String?
  reserva       Reserva? @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  /// Pesos enteros, copiado al crear el intento y nunca recalculado. Las
  /// pasarelas firman el monto: con Float, un redondeo rompía la firma o
  /// cobraba un peso de menos.
  monto         Int
  moneda        String   @default("COP")
  /// El adaptador que lo creó: 'falso' en pruebas, luego el de la pasarela.
  proveedor     String
  /// Id de la transacción en la pasarela. Llega con el primer evento; único
  /// para que el mismo webhook dos veces no se aplique dos veces.
  proveedorTxId String?  @unique
  /// pendiente | aprobado | rechazado | anulado | expirado | error
  ///
  /// Solo avanza: un rechazo que llega tarde no deshace una aprobación.
  estado        String   @default("pendiente")
  /// tarjeta | pse | nequi | bancolombia | ..., tal como lo reporte la pasarela.
  metodo        String?
  /// Motivo del rechazo, para el panel.
  motivo        String?
  /// prueba | produccion. La base es una sola: sin esto, los pagos del sandbox
  /// se mezclan con los reales en el panel y en las cifras.
  modo          String
  /// Último evento crudo de la pasarela, para responder un reclamo.
  payload       Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([pedidoId])
  @@index([reservaId])
}

model Contacto {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  /// Opcional: si lo dejan, se les puede contestar por WhatsApp.
  telefono  String?
  mensaje   String
  /// nuevo | respondido
  ///
  /// Lo marca el panel. Sin esto, si el aviso por correo o Telegram se perdía,
  /// el mensaje quedaba guardado sin que nadie supiera que existía.
  estado    String   @default("nuevo")
  createdAt DateTime @default(now())
}

/// Solicitud de cotización de un grupo: colegio, universidad, empresa o agencia.
///
/// Es hermana de `Contacto` y no una variante suya. Lo que las separa no es el
/// texto del mensaje sino que acá cada dato que decide la cotización tiene su
/// columna. Con todo dentro de `mensaje` no se puede filtrar por tamaño de
/// grupo, ni contar cuántas solicitudes escolares entran, ni saber cuántas se
/// perdieron — que es justo lo que hoy no se puede medir.
///
/// El otro motivo es el formulario: `/reservar/[slug]` tope el selector de
/// personas en `experiencia.capacidad` (12 y 8), así que un colegio de 40
/// estudiantes no tiene por dónde pedir. Este modelo es el que le abre la
/// puerta, y por eso `personas` no tiene tope de capacidad.
model SolicitudGrupo {
  id                 String    @id @default(cuid())
  /// colegio | universidad | empresa | agencia | otro
  tipo               String
  institucion        String
  nit                String?
  contacto           String
  cargo              String?
  email              String
  telefono           String
  personas           Int
  /// Rango de edades del grupo. Solo lo pide el formulario cuando es colegio:
  /// es lo que decide la póliza y el papeleo de menores.
  edades             String?
  fechaTentativa     DateTime?
  /// Slugs de las experiencias marcadas, o vacío si pidió algo a medida.
  experiencias       String[]  @default([])
  requiereTransporte Boolean   @default(false)
  requiereFactura    Boolean   @default(false)
  mensaje            String    @default("")
  /// nueva | contactada | cotizada | cerrada | perdida
  ///
  /// Entra ya, aunque en esta fase nadie lo cambie: la columna es gratis hoy y
  /// una migración sobre la única base de datos que hay —la de producción— no.
  estado             String    @default("nueva")
  createdAt          DateTime  @default(now())

  /// Como las va a listar el panel cuando exista la pantalla: las nuevas
  /// primero. Se crea con la tabla vacía a propósito.
  @@index([estado, createdAt(sort: Desc)])
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Traducción de una Experiencia a un idioma distinto del español.
///
/// El español vive en `Experiencia` y es la fuente de verdad: esto es una capa
/// encima, nunca al revés. Se crea sola al guardar en el panel —el service
/// llama a DeepL antes de responder— y el admin puede pulirla después.
///
/// Tabla por modelo y no una genérica `traduccion(entidad, campo, valor)`
/// porque tres de los campos traducibles son `String[]` de Postgres: en una
/// tabla genérica habría que serializarlos a JSON y perder el tipo justo en
/// los tres que el panel edita como listas.
model ExperienciaTraduccion {
  id            String      @id @default(cuid())
  experienciaId String
  experiencia   Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)
  /// Código del idioma: 'en'. El español no tiene fila; es el original.
  idioma        String

  /// El slug de esta versión: /en/experiences/cacao-trail. Si va vacío se cae
  /// al español y la URL inglesa usa el slug original, que funciona igual pero
  /// no posiciona.
  slug             String   @default("")
  nombre           String   @default("")
  descripcion      String   @default("")
  descripcionLarga String   @default("")
  duracion         String   @default("")
  horarios         String   @default("")
  recomendaciones  String   @default("")
  puntoEncuentro   String   @default("")
  incluye          String[] @default([])
  queTraer         String[] @default([])
  noIncluye        String[] @default([])

  /// Hash del español que se tradujo, campo a campo: { "nombre": "ab12", ... }.
  /// Cuando el admin edita el español, el hash deja de coincidir y el panel
  /// marca exactamente qué campo quedó viejo. Sin esto, una traducción se
  /// queda describiendo algo que ya no es cierto y nada avisa.
  origenHash Json @default("{}")

  /// Campos que tocó un humano: { "nombre": true }. La traducción automática
  /// nunca los reescribe, solo los marca como desactualizados. Sin esto,
  /// alguien pule un texto, cambia una coma en español y pierde el trabajo.
  revisados Json @default("{}")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([experienciaId, idioma])
  @@unique([idioma, slug])
  @@index([idioma])
}

/// Traducción de un Producto. Mismas reglas que ExperienciaTraduccion.
model ProductoTraduccion {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  idioma     String

  slug             String @default("")
  nombre           String @default("")
  descripcion      String @default("")
  descripcionLarga String @default("")
  /// La categoría se muestra como etiqueta en la tienda, así que se traduce.
  categoria        String @default("")

  origenHash    Json     @default("{}")
  revisados     Json     @default("{}")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([productoId, idioma])
  @@unique([idioma, slug])
  @@index([idioma])
}
